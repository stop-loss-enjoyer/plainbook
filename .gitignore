__pycache__/
*.pyc
*.tmp
# left by pip install . and by PyInstaller
build/
dist/
*.egg-info/
*.spec
.trash/
.drafts/
.restore/
# records never belong in this repository; the layout below is kept by .gitkeep
journal/*/*
journal/*.md
!journal/*/.gitkeep
# nor further down, where a copy of a journal would otherwise go unseen
*/**/journal/
# a backup of a journal holds every record; the folder of the bar widget in
# desktop/ only shares the ending
*.plainbook
!*.plainbook/
